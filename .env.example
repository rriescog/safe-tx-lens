# Safe Tx Lens configuration inventory. Copy to .env for a LOCAL process only.
# Leave unused values blank. Never commit .env or put credentials in a browser/MCP request.
# Production uses the GitHub variables and VPS secret files listed below; CI generates
# the VPS .env. This example is documentation, not a production secret template.

# Safe Transaction Service: required for public community mode and for reliable
# offchain queue/history lookup. A bare pending Safe hash needs an offchain source.
SAFE_API_KEY=
# Use a file instead of the inline key when running outside Docker.
SAFE_API_KEY_FILE=

# Optional source/ABI lookup. One Etherscan V2 key covers supported Etherscan
# chains by chain ID, including PolygonScan for Polygon PoS and Amoy.
ETHERSCAN_API_KEY=
ETHERSCAN_API_KEY_FILE=
# Optional OKLink ABI lookup, currently used for X Layer.
OKLINK_API_KEY=
OKLINK_API_KEY_FILE=

# Optional Tenderly simulation: all three values are required. A dedicated
# project/key is recommended for the public service. No key means no simulation.
TENDERLY_ACCESS_KEY=
TENDERLY_ACCESS_KEY_FILE=
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
# Local-only legacy monitor import. Never set this for the public service.
TENDERLY_MONITOR_ENV_FILE=

# Optional LOCAL RPC overrides. Use archive-capable endpoints for historical
# bytecode and storage. Public community mode deliberately rejects RPC_URL and
# RPC_URL_<NETWORK>; the hosted service uses the built-in public RPC routes.
# A supported chain ID alone does not establish archive reads or Safe API lists.
RPC_URL_ETH=
RPC_URL_POL=
RPC_URL_GNO=
RPC_URL_ARB1=
RPC_URL_OETH=
RPC_URL_BASE=
RPC_URL_SEP=
RPC_URL_AMOY=
RPC_URL_IMX=
RPC_URL_BNB=
RPC_URL_AVAX=
RPC_URL_KAT=
RPC_URL_XLAYER=
# Single-network local override; leave blank for cross-chain discovery.
RPC_URL=

# Public server settings. Compose sets PUBLIC_ORIGIN from DOMAIN and mounts
# the quota file at /data; change limits only after checking provider quotas.
PUBLIC_ORIGIN=
PUBLIC_DONATION_WALLETS=[]
# PUBLIC_QUOTA_FILE=/data/public-quota.json
PUBLIC_DAILY_LIMIT=5
# COMMUNITY_QUOTA_FILE=/data/community-quota.json
COMMUNITY_DAILY_UNITS=600
COMMUNITY_MONTHLY_UNITS=10000
COMMUNITY_CLIENT_DAILY_REQUESTS=20
COMMUNITY_SIMULATION_CLIENT_DAILY=3
COMMUNITY_SIMULATION_MONTHLY=100

# Production Compose values. CI writes DOMAIN and immutable IMAGE to the VPS
# .env on deployment. They are not Node process secrets.
DOMAIN=safetxlens.org
IMAGE=

# GitHub Actions repository VARIABLES (configure in GitHub, not in .env):
# DEPLOY_ENABLED, DEPLOY_DOMAIN, DEPLOY_HOST, DEPLOY_USER,
# DEPLOY_TENDERLY_ENABLED, DEPLOY_TENDERLY_ACCOUNT, DEPLOY_TENDERLY_PROJECT,
# DEPLOY_ETHERSCAN_ENABLED, DEPLOY_OKLINK_ENABLED.
# GitHub Actions repository SECRETS (configure in GitHub, not in .env):
# DEPLOY_SSH_KEY, DEPLOY_KNOWN_HOSTS, GHCR_READ_TOKEN.
# GITHUB_TOKEN is supplied automatically by GitHub Actions.
# VPS files, mode 0600: ~/safe-tx-lens/safe-api-key (required), plus optional
# tenderly-access-key, etherscan-api-key and oklink-api-key.
# Compose mounts them as SAFE_API_KEY_FILE, TENDERLY_ACCESS_KEY_FILE,
# ETHERSCAN_API_KEY_FILE and OKLINK_API_KEY_FILE respectively.
